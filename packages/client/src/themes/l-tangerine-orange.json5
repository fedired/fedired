		htmlThemeColor: '@bg',
		indicator: '@accent',
		focus: ':alpha<0.3<@accent',
		listItemHoverBg: 'rgba(255, 111, 0, 0.06)',
		X2: '#faf6f2',
		X3: 'rgba(255, 111, 0, 0.08)',
		X4: 'rgba(0, 0, 0, 0.1)',
		X5: 'rgba(0, 0, 0, 0.05)',
