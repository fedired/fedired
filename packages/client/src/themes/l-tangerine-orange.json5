		inputBorderHover: 'rgba(255, 111, 0, 0.45)',
		messageBg: '#faf6f2',
		acrylicBg: ':alpha<0.55<@bg',
		acrylicPanel: ':alpha<0.7<@panel',
		modalBg: 'rgba(42, 45, 55, 0.35)',
		scrollbarHandle: 'rgba(255, 111, 0, 0.45)',
