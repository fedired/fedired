		X7: 'rgba(0, 0, 0, 0.05)',
		X8: ':lighten<8<@accent',
		X9: ':darken<8<@accent',
		X10: ':alpha<0.35<@accent',
		X11: 'rgba(0, 0, 0, 0.08)',
		X12: 'rgba(0, 0, 0, 0.1)',
		X13: 'rgba(0, 0, 0, 0.12)',
		X14: ':alpha<0.5<@navBg',
