		infoWarnBg: '#fff0db',
		infoWarnFg: '#8f6e31',
		warn: '#ecb637',
		error: '#df405a',
		success: '#79bd9a',
		badge: '@accent',
		cwBg: '#e8e4f2',
		cwFg: '#2a2d37',
		cwHoverBg: '#dfdbed',
		driveFolderBg: ':alpha<0.3<@accent',
		wallpaperOverlay: 'rgba(242, 239, 245, 0.55)',
		htmlThemeColor: '@bg',
		indicator: '@accent',
		focus: ':alpha<0.3<@accent',
		listItemHoverBg: 'rgba(99, 100, 255, 0.06)',
