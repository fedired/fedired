		buttonHoverBg: '#e5ddf6',
		inputBorder: 'rgba(0, 0, 0, 0.12)',
		inputBorderHover: 'rgba(99, 100, 255, 0.45)',
		messageBg: '#f5f4f9',
		acrylicBg: ':alpha<0.55<@bg',
		acrylicPanel: ':alpha<0.7<@panel',
		modalBg: 'rgba(42, 45, 55, 0.35)',
		scrollbarHandle: 'rgba(99, 100, 255, 0.45)',
